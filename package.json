{
  "name": "iwacu-rwanda-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "legacy/*"
  ],
  "scripts": {
    "dev:web": "pnpm --dir apps/web dev",
    "dev:all": "pnpm -r --parallel dev",
    "build:web": "pnpm --dir apps/web build",
    "build:all": "pnpm -r build",
    "lint": "pnpm -r lint"
  }
}
